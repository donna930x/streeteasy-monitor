# Copy this file to ".env" (same folder) and fill in your real values.
# .env is gitignored — it stays on your machine and is never committed.

# --- Gmail (summary email) ---
# Use a Gmail App Password, NOT your normal password:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
ALERT_TO_EMAIL=you@gmail.com

# --- Google Sheet ---
# The Apps Script web-app /exec URL and the matching shared secret,
# plus the sheet link used in the email button.
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXX/exec
SHEETS_WEBHOOK_SECRET=your-long-random-secret
SHEET_URL=https://docs.google.com/spreadsheets/d/1tdFeH60up1P5DUJciu6BGnyihHiIGZJHwJEUlxFn5Mk/edit

# --- Proxy (NOT needed when running locally) ---
# Leave this unset/empty on your Mac — your home IP isn't blocked.
# SCRAPER_PROXY_URL=
